{
  "name": "@danielsimonjr/everything-mcp",
  "version": "3.1.0",
  "description": "MCP server for Everything search engine - blazing fast file search for Windows",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "bin": {
    "everything-mcp": "./src/index.ts"
  },
  "files": [
    "src",
    "bundle",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/index.ts --outfile=bundle/index.js --target=node --format=esm --minify",
    "test": "bun test",
    "smoke": "bun run scripts/stdio-smoke.ts",
    "prepublishOnly": "bun run typecheck && bun run build && bun run smoke"
  },
  "keywords": [
    "mcp",
    "everything",
    "search",
    "file-search",
    "windows",
    "es.exe",
    "voidtools",
    "bun"
  ],
  "author": "Daniel Simon Jr. (https://github.com/danielsimonjr)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/danielsimonjr/everything-mcp.git"
  },
  "homepage": "https://github.com/danielsimonjr/everything-mcp"
}
